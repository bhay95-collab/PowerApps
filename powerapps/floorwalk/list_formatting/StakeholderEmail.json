{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "a",
  "txtContent": "@currentField",
  "attributes": {
    "href": "='mailto:' + @currentField",
    "target": "_blank"
  },
  "style": {
    "color": "#1A5A99",
    "text-decoration": "none",
    "display": "=if(@currentField == '', 'none', 'inline')"
  }
}